{
  "name": "type-react-kit",
  "private": true,
  "version": "0.20.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "build:e2e": "tsc -b && vite build --config vite.config.ts --mode e2e",
    "preview:e2e": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "analyze": "tsc -b && vite build --config vite.config.ts --mode analyze",
    "lint": "eslint .",
    "typecheck": "npm run typecheck:source && npm run typecheck:test",
    "typecheck:source": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "check:reachability": "node scripts/checkProductionReachability.mjs",
    "test": "vitest run",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "npm run typecheck:e2e && npm run build:e2e && node scripts/runPlaywrightE2e.mjs",
    "test:e2e:headed": "npm run typecheck:e2e && npm run build:e2e && playwright test --headed",
    "test:e2e:ui": "npm run typecheck:e2e && npm run build:e2e && playwright test --ui",
    "update:export-fixtures": "node scripts/updateExportFixtures.mjs",
    "compatibility:check": "vitest run tests/compatibilityExports.test.ts"
  },
  "dependencies": {
    "@types/opentype.js": "^1.3.10",
    "@vitejs/plugin-react": "^4.3.4",
    "opentype.js": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "valibot": "^1.4.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.1",
    "@playwright/test": "^1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.0.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "comlink": "^4.4.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
